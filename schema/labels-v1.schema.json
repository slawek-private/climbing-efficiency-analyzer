{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climbing-efficiency-analyzer.local/schema/labels-v1",
  "title": "Manual climbing labels v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "climber",
    "attempt",
    "route",
    "outcome",
    "start",
    "end",
    "events",
    "open_events",
    "reviewed",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "time_base",
        "first_pts",
        "frame_count"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "time_base": {
          "type": "string"
        },
        "first_pts": {
          "type": "integer"
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "climber": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "unknown",
        "failed",
        "completed",
        "abandoned"
      ]
    },
    "start": {
      "anyOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "type": "null"
        }
      ]
    },
    "end": {
      "anyOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "open_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openEvent"
      }
    },
    "reviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_contacts",
        "right_contacts",
        "rests",
        "clips",
        "boundaries"
      ],
      "properties": {
        "left_contacts": {
          "type": "boolean"
        },
        "right_contacts": {
          "type": "boolean"
        },
        "left_offwall": {
          "type": "boolean"
        },
        "right_offwall": {
          "type": "boolean"
        },
        "rests": {
          "type": "boolean"
        },
        "clips": {
          "type": "boolean"
        },
        "boundaries": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "point"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "point": {
            "$ref": "#/$defs/point"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "footwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_version",
        "events",
        "coverage",
        "pending",
        "fall_onset"
      ],
      "properties": {
        "definition_version": {
          "const": "1.0.0"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "limb",
              "start",
              "end",
              "intent",
              "status",
              "observation",
              "interpretation",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "slip",
                  "both_off",
                  "foot_release"
                ]
              },
              "limb": {
                "enum": [
                  "left",
                  "right",
                  "both",
                  "uncertain"
                ]
              },
              "start": {
                "$ref": "#/$defs/point"
              },
              "end": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/point"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intent": {
                "enum": [
                  "unplanned",
                  "intentional",
                  "uncertain"
                ]
              },
              "status": {
                "enum": [
                  "confirmed",
                  "uncertain",
                  "candidate"
                ]
              },
              "observation": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "start",
              "end",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "$ref": "#/$defs/point"
              },
              "end": {
                "$ref": "#/$defs/point"
              },
              "state": {
                "enum": [
                  "reviewed",
                  "obscured"
                ]
              }
            }
          }
        },
        "pending": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "intent"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/point"
                },
                "intent": {
                  "enum": [
                    "unplanned",
                    "intentional",
                    "uncertain"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "fall_onset": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "coaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "reflection",
        "action",
        "retest"
      ],
      "properties": {
        "goal": {
          "type": "string"
        },
        "reflection": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "retest": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discipline",
        "grade",
        "wall_angle",
        "familiarity"
      ],
      "properties": {
        "discipline": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "wall_angle": {
          "type": "string"
        },
        "familiarity": {
          "type": "string"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "athlete",
        "session",
        "route"
      ],
      "properties": {
        "athlete": {
          "$ref": "#/$defs/athlete"
        },
        "session": {
          "$ref": "#/$defs/session"
        },
        "route": {
          "$ref": "#/$defs/routeVersion"
        }
      }
    },
    "clip_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "point",
          "visibility",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "point": {
            "$ref": "#/$defs/point"
          },
          "visibility": {
            "enum": [
              "missing",
              "partial"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "pts",
        "seconds"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "pts": {
          "type": "integer"
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "hand",
        "target",
        "start",
        "end",
        "confidence",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "contact",
            "rest",
            "clip",
            "offwall",
            "chalk"
          ]
        },
        "hand": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        },
        "target": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        },
        "clip_method": {
          "enum": [
            "mouth",
            "direct",
            "unknown"
          ],
          "description": "Explicit method; unknown requires a reason. Absent is unanswered, not a guess."
        },
        "clip_reason": {
          "enum": [
            "",
            "hidden",
            "camera",
            "unclear"
          ]
        }
      }
    },
    "openEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "hand",
        "target",
        "start",
        "confidence",
        "notes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "contact",
            "rest",
            "clip",
            "offwall",
            "chalk"
          ]
        },
        "hand": {
          "enum": [
            "left",
            "right",
            "none"
          ]
        },
        "target": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        },
        "clip_method": {
          "enum": [
            "mouth",
            "direct",
            "unknown"
          ],
          "description": "Explicit method; unknown requires a reason. Absent is unanswered, not a guess."
        },
        "clip_reason": {
          "enum": [
            "",
            "hidden",
            "camera",
            "unclear"
          ]
        }
      }
    },
    "athlete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label",
        "teams"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "date",
        "team",
        "event",
        "round",
        "goal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "training",
            "competition"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "team": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "round": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "routeVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "discipline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "discipline": {
          "enum": [
            "lead",
            "boulder",
            "speed",
            "other"
          ]
        }
      }
    }
  }
}
